# ============================================================
#   IBM CLOUD & WATSONX.AI CONFIGURATION (Lite / Free Tier)
# ============================================================

# ── IBM Cloud API Key ─────────────────────────────────────────
# Generate at: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# ── IBM watsonx.ai Project ID ─────────────────────────────────
# Found in: watsonx.ai → Your Project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── IBM watsonx.ai Service URL (Lite region) ──────────────────
# Dallas (us-south) → default Lite region
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Granite Model IDs (available on Lite tier) ────────────
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
GRANITE_CHAT_MODEL_ID=ibm/granite-3-8b-instruct

# ── Model Generation Parameters ───────────────────────────────
GRANITE_MAX_NEW_TOKENS=1024
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.9
GRANITE_TOP_K=50
GRANITE_REPETITION_PENALTY=1.1

# ============================================================
#   WEATHER API  (Open-Meteo — FREE, no key required)
# ============================================================
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# ============================================================
#   GEOCODING API  (Nominatim/OpenStreetMap — FREE)
# ============================================================
GEOCODING_API_BASE_URL=https://nominatim.openstreetmap.org

# ============================================================
#   REST COUNTRIES API  (FREE, no key required)
# ============================================================
COUNTRIES_API_BASE_URL=https://restcountries.com/v3.1

# ============================================================
#   OPEN TRIP MAP  (Points of interest — Free tier)
# ============================================================
# Sign up FREE at: https://opentripmap.io/
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1/en

# ============================================================
#   EXCHANGE RATES  (ExchangeRate-API — Free tier)
# ============================================================
# Sign up FREE at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# ============================================================
#   APPLICATION SERVER
# ============================================================
PORT=3000
NODE_ENV=development
APP_NAME=Travel Planner Agent

# ============================================================
#   CACHE SETTINGS
# ============================================================
CACHE_TTL_WEATHER=1800
CACHE_TTL_PLACES=86400
CACHE_TTL_EXCHANGE=3600
