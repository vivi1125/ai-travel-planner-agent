# ============================================================
#  IBM watsonx.ai — Travel Planner Agent  |  .env.example
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to version control.
# ============================================================

# ── Step 1: Get a FREE IBM Cloud account ─────────────────────
#   https://cloud.ibm.com/registration

# ── Step 2: Create an IBM Cloud API Key ──────────────────────
#   IBM Cloud → Manage → Access (IAM) → API Keys → Create
IBM_CLOUD_API_KEY=f3859a28-80a0-4b1a-a638-717addec97f3

# ── Step 3: Create a watsonx.ai project ──────────────────────
#   https://dataplatform.cloud.ibm.com/wx/home
#   → New Project → copy the Project ID from Manage → General
WATSONX_PROJECT_ID=65477763-209c-41a7-b3a4-6e4f6011fbda

# ── Step 4: watsonx.ai service URL ───────────────────────────
#   Dallas (us-south) is the default Lite-tier region.
#   Other options: eu-de (Frankfurt), eu-gb (London), jp-tok (Tokyo)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Granite model to use (Lite tier — no cost) ───────────────
#   Recommended fast model:
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Generation parameters (optional — defaults shown) ────────
GRANITE_MAX_TOKENS=1200
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.9
